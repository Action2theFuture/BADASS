#!/bin/sh
# Part 2-A : static VXLAN on router-junsan-2 (VTEP 10.1.1.2 -> peer 10.1.1.1)
ip link del vxlan10 2>/dev/null            # idempotent: remove previous tunnel
ip link add vxlan10 type vxlan id 10 local 10.1.1.2 remote 10.1.1.1 dev eth0 dstport 4789
ip link set vxlan10 up
ip link set vxlan10 master br0             # join the host-side bridge
